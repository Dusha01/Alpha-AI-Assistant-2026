# Локальные значения для docker compose. Рабочий файл — .env.dev

POSTGRES_USER=alfa
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=alfa_course
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql+asyncpg://alfa:dev_only_change_me@postgres:5432/alfa_course
DATABASE_URL_HOST=postgresql+asyncpg://alfa:dev_only_change_me@localhost:5432/alfa_course

TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
APP_ENV=dev
DEBUG=true
LOG_LEVEL=DEBUG
