#!/usr/bin/env sh

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [ -z "$REPO_ROOT" ]; then
	REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
fi

cd "$REPO_ROOT" || exit 1

STAGED_FILES="$(
	git diff --cached --name-only --diff-filter=ACMR
)"

if [ -z "$STAGED_FILES" ]; then
	echo "No staged files. Skipping pre-commit checks."
	exit 0
fi

echo "Staged changes detected. Running ruff and pytest..."

RUFF="$REPO_ROOT/.venv/bin/ruff"
PYTEST="$REPO_ROOT/.venv/bin/pytest"

if [ ! -x "$RUFF" ]; then
	echo "Ruff not found in .venv ($RUFF)."
	echo "Create venv and install dev deps:"
	echo "  python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"
	exit 1
fi

if [ ! -x "$PYTEST" ]; then
	echo "pytest not found in .venv ($PYTEST)."
	echo "  .venv/bin/pip install -r requirements-dev.txt"
	exit 1
fi

ruff_verify() {
	"$RUFF" check src tests && "$RUFF" format --check src tests
}

ruff_autofix() {
	echo "Ruff reported issues — fixing via .venv..."
	"$RUFF" check src tests --fix
	"$RUFF" format src tests
	# Подтянуть только то, что ruff мог изменить.
	git add -u src tests 2>/dev/null || true
}

echo "Running ruff (from .venv)..."
if ! ruff_verify; then
	ruff_autofix
	if ! ruff_verify; then
		echo "Ruff still fails after auto-fix. Correct remaining issues manually."
		exit 1
	fi
	echo "Ruff auto-fix applied; updated files re-staged."
fi

echo "Running pytest..."
if ! "$PYTEST" -q -m "not integration and not questions"; then
	echo "pytest failed."
	exit 1
fi

echo "pre-commit checks passed."
exit 0
